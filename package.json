{
  "name": "@tws/world-forge",
  "version": "0.3.0",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "benchmark:generation": "tsx --tsconfig tsconfig.scripts.json scripts/benchmark-generation.ts",
    "benchmark:workflows": "tsx --tsconfig tsconfig.scripts.json scripts/compare-generation-workflows.ts",
    "profile:generation": "tsx --tsconfig tsconfig.scripts.json scripts/profile-current-generation.ts",
    "profile:production-page": "tsx --tsconfig tsconfig.scripts.json scripts/profile-production-page-runner.ts",
    "profile:production-page:inner": "tsx --tsconfig tsconfig.scripts.json scripts/profile-production-page.ts",
    "profile:production-rerank": "tsx --tsconfig tsconfig.scripts.json scripts/profile-production-rerank.ts",
    "reference:prepare-earth": "python tools/reference-etl/prepare_etopo_earth.py",
    "reference:prepare-jupiter": "python tools/reference-etl/prepare_jupiter_reference.py",
    "reference:build-earth": "tsx --tsconfig tsconfig.scripts.json scripts/build-earth-reference.ts",
    "test:production-page-harness": "tsx --tsconfig tsconfig.scripts.json scripts/profile-production-page-runner.ts --self-test && npm run profile:production-page:inner -- --self-test",
    "test:production-rerank": "tsx --tsconfig tsconfig.scripts.json scripts/profile-production-rerank.ts --self-test",
    "smoke:production-page-harness": "npm run profile:production-page -- --skip-build --browser chrome --headless --resolution 256x128 --runs 1 --warmup 0 --timeout-minutes 5 --output .local/performance/production-page-ci-smoke",
    "smoke:production-rerank": "npm run profile:production-rerank -- --skip-build --browser chrome --headless --resolution 256x128 --runs 1 --timeout-minutes 5 --output .local/performance/production-rerank-ci-smoke",
    "evaluate:regions": "tsx --tsconfig tsconfig.scripts.json scripts/evaluate-geographic-regions.ts",
    "investigate:map-lines-polar-ice": "tsx --tsconfig tsconfig.scripts.json scripts/investigate-map-lines-polar-ice.ts",
    "investigate:striping": "tsx --tsconfig tsconfig.scripts.json scripts/investigate-vertical-striping.ts",
    "triage:surface": "tsx --tsconfig tsconfig.scripts.json scripts/run-surface-quality-triage.ts",
    "validate:presets": "tsx --tsconfig tsconfig.scripts.json scripts/run-preset-validation.ts",
    "workflow:legacy": "tsx --tsconfig tsconfig.scripts.json scripts/run-generation-workflow.ts",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "validate": "npm run typecheck && npm test && npm run test:production-page-harness && npm run test:production-rerank",
    "verify": "npm run validate && npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.2",
    "firebase": "^12.15.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.561.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "three": "^0.185.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "playwright": "^1.61.1",
    "tsx": "^4.22.4",
    "vitest": "^4.0.15"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "uuid": "^11.1.1"
  }
}
